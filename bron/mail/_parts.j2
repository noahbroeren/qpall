{#- Shared building blocks for the Q-Pall confirmation e-mails (tables + inline styles, Outlook-safe) -#}
{%- set F = 'font-family:Arial,Helvetica,sans-serif;' -%}
{%- set NAVY = '#1D1C4C' -%}{%- set TEXT = '#46455F' -%}{%- set MUTED = '#6B6A82' -%}{%- set ORANGE = '#F37321' -%}{%- set LINE = '#E3E3EA' -%}{%- set SOFT = '#F3F3F3' -%}

{%- macro head(subject, preheader, lang, bg='#F3F3F3', extra_css='') -%}
<!doctype html>
<html lang="{{ lang }}" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ subject }}</title>
<!--[if mso]><style>table,td,p,a,span,h1,h2{font-family:Arial,Helvetica,sans-serif!important}</style><![endif]-->
<style>
  body{margin:0!important;padding:0!important;width:100%!important;background:{{ bg }}}
  a{text-decoration:none}
  @media (max-width:620px){
    .w100{width:100%!important;max-width:100%!important}
    .px{padding-left:22px!important;padding-right:22px!important}
    .hide-sm{display:none!important}
    .h1{font-size:23px!important;line-height:29px!important}
    .img-fluid{width:100%!important;height:auto!important}
    .block{display:block!important;width:100%!important;box-sizing:border-box!important}
    .facts td.lab,.facts td.val{display:block!important;width:100%!important}
    .facts td.lab{padding-bottom:0!important}
    .thumb-td{width:56px!important;padding-right:10px!important}
    .thumb{width:56px!important;height:37px!important}
    .qty-td{white-space:normal!important}
    .card-in{padding:20px 16px 18px!important}
    .btn-td{display:block!important;padding-right:0!important}
    .col{display:block!important;width:100%!important;padding:0 0 14px 0!important;box-sizing:border-box!important}
    .stk{display:block!important;width:100%!important;box-sizing:border-box!important;padding:24px 22px 0!important}
    .stk-last{display:block!important;width:100%!important;box-sizing:border-box!important;padding:18px 22px 24px!important}
    .card2{display:block!important;width:100%!important;box-sizing:border-box!important;margin:0 0 12px!important}
    {{ extra_css }}
  }
</style>
</head>
<body style="margin:0;padding:0;background:{{ bg }};">
<div style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:{{ bg }};">{{ preheader }}&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ bg }}" style="background:{{ bg }};">
<tr><td align="center" style="padding:24px 12px 32px;">
<table role="presentation" class="w100" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;">
{%- endmacro %}

{%- macro end() -%}
</table>
</td></tr>
</table>
</body>
</html>
{%- endmacro %}

{%- macro eyebrow(text, color=ORANGE, top=0) -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:{{ top }}px 0 0;"><tr>
  <td width="24" style="width:24px;padding:0 10px 0 0;vertical-align:middle;"><div style="height:2px;line-height:2px;font-size:2px;background:{{ color }};">&nbsp;</div></td>
  <td style="vertical-align:middle;{{ F }}font-size:11px;line-height:14px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:{{ color }};">{{ text }}</td>
</tr></table>
{%- endmacro %}

{%- macro h2(text, top=0, bar=ORANGE) -%}
<div style="width:28px;height:3px;line-height:3px;font-size:3px;background:{{ bar }};margin-top:{{ top }}px;">&nbsp;</div>
<h2 style="margin:12px 0 14px;{{ F }}font-size:19px;line-height:24px;font-weight:bold;color:{{ NAVY }};">{{ text }}</h2>
{%- endmacro %}

{#- product rows: thumbnail, name + article number, quantity + stacks. The parts are separate macros so the Netlify
   function can build the rows itself (mail/build: one row with tokens, see mailgen.py) -#}
{%- macro thumb_img(src) -%}<img class="thumb" src="{{ src }}" width="96" height="64" alt="" style="display:block;border:0;width:96px;height:64px;border-radius:6px;">{%- endmacro %}
{%- macro thumb_empty() -%}<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="thumb" width="96" height="64" bgcolor="{{ SOFT }}" style="width:96px;height:64px;background:{{ SOFT }};border-radius:6px;font-size:0;line-height:0;">&nbsp;</td></tr></table>{%- endmacro %}
{%- macro stacks_line(text) -%}<br><span style="{{ F }}font-size:12px;line-height:18px;color:{{ MUTED }};white-space:nowrap;">{{ text }}</span>{%- endmacro %}
{%- macro sku_line(text) -%}<br><span style="{{ F }}font-size:12px;line-height:18px;color:{{ MUTED }};">{{ text }}</span>{%- endmacro %}
{%- macro product_row(thumb, name, sku, qty, stacks) -%}
  <tr>
    <td class="thumb-td" width="96" style="width:96px;padding:12px 14px 12px 0;border-top:1px solid {{ LINE }};vertical-align:middle;">{{ thumb }}</td>
    <td style="padding:12px 10px 12px 0;border-top:1px solid {{ LINE }};vertical-align:middle;{{ F }}">{{ name }}{{ sku }}</td>
    <td class="qty-td" align="right" style="padding:12px 0;border-top:1px solid {{ LINE }};vertical-align:middle;text-align:right;white-space:nowrap;{{ F }}"><span style="{{ F }}font-size:14px;line-height:19px;font-weight:bold;color:{{ NAVY }};white-space:nowrap;">{{ qty }}</span>{{ stacks }}</td>
  </tr>
{%- endmacro %}
{%- macro products(items) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  {%- for it in items %}
  {{ product_row(thumb_img(it.thumb) if it.thumb else thumb_empty(), pname(it), sku_line(it.sku) if it.sku else '', it.qty, stacks_line(it.stacks) if it.stacks else '') }}
  {%- endfor %}
</table>
{%- endmacro %}

{%- macro pname(it, size=14) -%}
{%- if it.url %}<a href="{{ it.url }}" style="{{ F }}font-size:{{ size }}px;line-height:{{ size + 5 }}px;font-weight:bold;color:{{ NAVY }};text-decoration:none;">{{ it.name }}</a>
{%- else %}<span style="{{ F }}font-size:{{ size }}px;line-height:{{ size + 5 }}px;font-weight:bold;color:{{ NAVY }};">{{ it.name }}</span>{% endif %}
{%- endmacro %}

{%- macro fact_row(k, v) -%}
  <tr>
    <td class="lab" width="190" style="width:190px;padding:9px 12px 9px 0;vertical-align:top;{{ F }}font-size:11px;line-height:18px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;color:{{ MUTED }};">{{ k }}</td>
    <td class="val" style="padding:9px 0;vertical-align:top;{{ F }}font-size:14px;line-height:18px;color:{{ NAVY }};">{{ v }}</td>
  </tr>
{%- endmacro %}

{%- macro facts_table(facts, top_border=True) -%}
<table role="presentation" class="facts" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 0;{% if top_border %}border-top:1px solid {{ LINE }};{% endif %}">
  {%- for k, v in facts %}
  {{ fact_row(k, v) }}
  {%- endfor %}
</table>
{%- endmacro %}

{%- macro message_box(label, message, bg=SOFT) -%}
{%- if message %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:10px 0 0;"><tr>
  <td bgcolor="{{ bg }}" style="background:{{ bg }};border-radius:10px;padding:14px 16px;{{ F }}">
    <span style="{{ F }}font-size:11px;line-height:18px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;color:{{ MUTED }};">{{ label }}</span><br>
    <span style="{{ F }}font-size:14px;line-height:21px;color:{{ NAVY }};">{{ message }}</span>
  </td></tr></table>
{%- endif %}
{%- endmacro %}

{%- macro change(fm) -%}
<p style="margin:14px 0 0;{{ F }}font-size:13px;line-height:20px;color:{{ TEXT }};">{{ fm.sum.change }} <a href="mailto:info@qpall.com?subject={{ fm.sum.mail_subject|urlencode }}" style="color:{{ NAVY }};text-decoration:underline;">info@qpall.com</a>.</p>
{%- endmacro %}

{%- macro dot(i, color, size=32) -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
  <td width="{{ size }}" height="{{ size }}" align="center" bgcolor="{{ color }}" style="width:{{ size }}px;height:{{ size }}px;border-radius:{{ size // 2 }}px;background:{{ color }};text-align:center;vertical-align:middle;{{ F }}font-size:{{ 14 if size >= 30 else 12 }}px;line-height:{{ size }}px;font-weight:bold;color:#FFFFFF;">{{ '&#10003;'|safe if i == 0 else i + 1 }}</td>
</tr></table>
{%- endmacro %}

{%- macro steps_vertical(fm, dots, when=ORANGE) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  {%- for s in fm.next.steps %}
  <tr>
    <td width="32" style="width:32px;padding:0 14px {{ '0' if loop.last else '18px' }} 0;vertical-align:top;">{{ dot(loop.index0, dots[loop.index0]) }}</td>
    <td style="padding:0 0 {{ '0' if loop.last else '18px' }};vertical-align:top;{{ F }}">
      <span style="{{ F }}font-size:11px;line-height:16px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;color:{{ when }};">{{ s.when }}</span><br>
      <span style="{{ F }}font-size:15px;line-height:21px;font-weight:bold;color:{{ NAVY }};">{{ s.t }}</span><br>
      <span style="{{ F }}font-size:13px;line-height:20px;color:{{ TEXT }};">{{ s.d }}</span>
    </td>
  </tr>
  {%- endfor %}
</table>
{%- endmacro %}

{%- macro signoff(x) -%}
<span style="{{ F }}font-size:14px;line-height:22px;color:{{ TEXT }};">{{ x.regards }}</span><br>
<span style="{{ F }}font-size:14px;line-height:22px;font-weight:bold;color:{{ NAVY }};">{{ x.team }}</span>
{%- endmacro %}

